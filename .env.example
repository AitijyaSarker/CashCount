# MongoDB connection string (use Atlas or local replica set for transactions)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=cashcount

# Field encryption key used by server/crypto.ts (32+ chars recommended)
FIELD_ENCRYPTION_KEY=replace_with_secure_key

# Node environment
NODE_ENV=development
# APP_URL: The URL where this app is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens (HMAC-SHA256)
JWT_SECRET="replace_with_strong_random_secret"

# ENCRYPTION_KEY: 256-bit AES encryption key (32 bytes hex or UTF-8) for encrypting sensitive fields at rest
ENCRYPTION_KEY="replace_with_32_byte_hex_or_base64_key"

